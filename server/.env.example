# Server 
NODE_ENV=development
PORT=5000


# MongoDB (REQUIRED: stores alerts)
MONGO_URI=mongodb://localhost:27017/api_monitoring
MONGO_DB_NAME=api_monitoring

# Postgredb 
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=api_monitoring
PG_USER=postgres
PG_PASSWORD=latif

# RabbitMQ
RABBITMQ_URL=amqp://api_user:secure_passwoed@localhost:5672/api_monitoring
RABBITMQ_QUEUE=api_hits

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

VALID_API_KEYS=test_key_123,test_key_456,food_delevery-api-key-2024

# RATE LIMIT
RATE_LIMIT_WINDOW_MS=600000
RETE_T_MAX_REQUESTS=100



# Anomaly rules 
ALERT_WARN_RESPONSE_MS=2000
ALERT_CRITICAL_RESPONSE_MS=5000
ALERT_DEDUPE_WINDOW_MIN=10
MONITOR_MAX_BATCH=500
MONITOR_API_KEY=


API_MONITOR_URL=http://localhost:5000/monitor
API_MONITOR_KEY=
API_MONITOR_ENABLED=true

# LLM (OpenAI) 

OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_TIMEOUT_MS=8000
LLM_RETRIES=2



# Optional email reports 
ALERT_EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mdabdullatifdelta@gmail.com
SMTP_PASS=
SMTP_FROM=mdabdullatifdelta@gmail.com
ALERT_EMAIL_TO=mdabdullatifdelta@gmail.com